# Copy this file to .env and fill in your API keys

# Required for Claude-based sentiment scoring
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: NewsAPI for real-time news sentiment
NEWSAPI_KEY=your_newsapi_key_here

# Optional: Polygon.io for higher-quality market data
POLYGON_API_KEY=your_polygon_api_key_here

# Optional: Databento — per-contract futures bars for the back-adjusted
# continuous series (trend_model/fetch_databento.py). Pay-as-you-go; this
# pull is daily bars only and signup credits typically cover it.
DATABENTO_API_KEY=your_databento_api_key_here
