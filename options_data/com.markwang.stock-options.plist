<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.markwang.stock-options</string>
    <!-- caffeinate -i -s holds the Mac awake until the job finishes, so a run that starts
         during a brief dark wake completes instead of freezing mid-run. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/opt/homebrew/Caskroom/miniforge/base/envs/trading-model/bin/python</string>
        <string>/Users/markwang/Desktop/trading_model/options_data/collect_extras.py</string>
        <string>--part</string>
        <string>stock_options</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/markwang/Desktop/trading_model/options_data</string>
    <!-- 12:00 PT (core 50 first, then ~450 S&P names, ~12 min), pre-close retries 12:30/12:45/12:57, post-close fallbacks 15:10/18:10. Weekdays, Pacific time. Idempotent: a retry only fills gaps. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
